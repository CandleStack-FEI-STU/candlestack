{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "oxc", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["dist", "site", "src/api/schema.d.ts"],
  "rules": {
    "complexity": ["error", { "max": 10 }],
    "max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": ["warn", { "max": 40, "skipBlankLines": true, "skipComments": true, "IIFEs": true }],
    "max-params": ["error", 5],
    "max-depth": ["error", 4],
    "no-console": "error",
    "eqeqeq": ["error", "smart"],
    "no-var": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/ban-ts-comment": ["error", { "ts-expect-error": "allow-with-description" }],
    "import/no-cycle": "error",
    "unicorn/no-array-sort": "off",
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": { "react/only-export-components": "off" }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": { "max-lines-per-function": "off" }
    }
  ]
}
