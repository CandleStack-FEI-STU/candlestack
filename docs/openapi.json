{
  "components": {
    "schemas": {
      "CandlesMeta": {
        "properties": {
          "count": {
            "description": "Number of candles returned.",
            "examples": [
              3
            ],
            "title": "Count",
            "type": "integer"
          },
          "end": {
            "description": "End of the period (exclusive), UTC epoch seconds.",
            "examples": [
              1717214400
            ],
            "title": "End",
            "type": "integer"
          },
          "feed": {
            "enum": [
              "spot",
              "iex"
            ],
            "examples": [
              "spot"
            ],
            "title": "Feed",
            "type": "string"
          },
          "fingerprint": {
            "description": "`sha256:<hex>` over the request and its candles: the same candles give the same value, any changed number another.",
            "examples": [
              "sha256:3b1f0c9e5d7a4b2c8e6f1a0d9c7b5e3f2a4c6e8d0b1f3a5c7e9d2b4f6a8c0e1d"
            ],
            "title": "Fingerprint",
            "type": "string"
          },
          "gaps": {
            "description": "Missing candles as merged `[start, end)` ranges in UTC epoch seconds, earliest first, at most 100.",
            "examples": [
              [
                [
                  1717207200,
                  1717210800
                ]
              ]
            ],
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            "title": "Gaps",
            "type": "array"
          },
          "gaps_total": {
            "description": "Number of missing candles in total.",
            "examples": [
              1
            ],
            "title": "Gaps Total",
            "type": "integer"
          },
          "instrument": {
            "description": "Instrument id, normalised.",
            "examples": [
              "crypto:BTCUSDT"
            ],
            "title": "Instrument",
            "type": "string"
          },
          "source": {
            "enum": [
              "binance",
              "alpaca"
            ],
            "examples": [
              "binance"
            ],
            "title": "Source",
            "type": "string"
          },
          "start": {
            "description": "Start of the period (inclusive), UTC epoch seconds.",
            "examples": [
              1717200000
            ],
            "title": "Start",
            "type": "integer"
          },
          "timeframe": {
            "$ref": "#/components/schemas/Timeframe",
            "examples": [
              "1h"
            ]
          }
        },
        "required": [
          "instrument",
          "timeframe",
          "start",
          "end",
          "source",
          "feed",
          "fingerprint",
          "count",
          "gaps",
          "gaps_total"
        ],
        "title": "CandlesMeta",
        "type": "object"
      },
      "CandlesOut": {
        "description": "Candles as columns: index `i` of every array is one candle, oldest first.",
