          "c": {
            "description": "Close prices.",
            "examples": [
              [
                67612.4,
                67540.3,
                67601.9
              ]
            ],
            "items": {
              "type": "number"
            },
            "title": "C",
            "type": "array"
          },
          "h": {
            "description": "High prices.",
            "examples": [
              [
                67700.0,
                67650.0,
                67640.0
              ]
            ],
            "items": {
              "type": "number"
            },
            "title": "H",
            "type": "array"
          },
          "l": {
            "description": "Low prices.",
            "examples": [
              [
                67420.2,
                67510.0,
                67488.8
              ]
            ],
            "items": {
              "type": "number"
            },
            "title": "L",
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/CandlesMeta"
          },
          "o": {
            "description": "Open prices.",
            "examples": [
              [
                67491.0,
                67612.5,
                67580.1
              ]
            ],
            "items": {
              "type": "number"
            },
            "title": "O",
            "type": "array"
          },
          "t": {
            "description": "Open times, UTC epoch seconds, strictly increasing.",
            "examples": [
              [
                1717200000,
                1717203600,
                1717210800
              ]
            ],
            "items": {
              "type": "integer"
            },
            "title": "T",
            "type": "array"
          },
          "v": {
            "description": "Volumes: base asset for crypto, shares (IEX only) for stocks.",
            "examples": [
              [
                512.31,
                398.07,
                421.55
              ]
            ],
            "items": {
              "type": "number"
            },
            "title": "V",
            "type": "array"
          }
        },
        "required": [
          "meta",
          "t",
          "o",
          "h",
          "l",
          "c",
          "v"
        ],
        "title": "CandlesOut",
        "type": "object"
      },
