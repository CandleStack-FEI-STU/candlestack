  "info": {
    "description": "HTTP API of CandleStack, a lab for experiments on financial time series. Market data covers crypto from Binance and US stocks from Alpaca. Times are UTC epoch seconds. Errors are RFC 9457 problem details (`application/problem+json`).",
    "title": "CandleStack API",
    "version": "snapshot"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "200 when the app and its Redis work, 503 with the same body when Redis does not.\n\nThe body is compact JSON: deploy checks look for `\"version\":\"<version>\"` and the commit.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Redis is unreachable"
          }
        },
        "summary": "Health of the app",
        "tags": [
          "health"
        ]
      }
    }
  }
