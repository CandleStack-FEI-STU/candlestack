  "info": {
    "description": "<img src=\"/favicon.svg\" alt=\"CandleStack\" width=\"40\" height=\"40\">\n\nHTTP API of CandleStack, a lab for experiments on financial time series. Market data covers crypto from Binance and US stocks from Alpaca. Times in responses are UTC epoch seconds; requests also accept ISO 8601. Errors are RFC 9457 problem details (`application/problem+json`).\n\n[Website](https://candlestack.tech) \u00b7 [Source code](https://github.com/CandleStack-FEI-STU/candlestack) \u00b7 [Status](https://ops.candlestack.tech)",
    "title": "CandleStack API",
    "version": "snapshot"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "200 when the app and its Redis work, 503 with the same body when Redis does not.\n\nThe body is compact JSON: deploy checks look for `\"version\":\"<version>\"` and the commit.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Redis is unreachable"
          }
        },
        "summary": "Health of the app",
        "tags": [
          "health"
        ]
      }
    },
    "/api/health/sources": {
      "get": {
        "description": "Reachability of Binance (`GET /api/v3/ping`) and Alpaca (`GET /v2/clock`), checked at\nmost once a minute. 200 when both answer, 503 with the same body when one does not.",
        "operationId": "sources_health_api_health_sources_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourcesHealthOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourcesHealthOut"
                }
              }
            },
            "description": "A source is unreachable"
          }
        },
        "summary": "Health of the data sources",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/data/candles": {
      "get": {
        "description": "Closed candles of one instrument and timeframe with `start <= t < end`.\n\nStocks have regular-session candles only (09:30-16:00 New York), aligned to the session\nopen. Missing candles are never filled; `meta.gaps` reports them. Limits: `max_candles`\nexpected candles per request (see the instrument detail) and a per-minute number of\ncandle and instrument requests per client address.",
        "operationId": "candles_api_v1_data_candles_get",
        "parameters": [
          {
            "description": "Instrument id, `<market>:<symbol>`.",
            "in": "query",
            "name": "instrument",
            "required": true,
            "schema": {
              "description": "Instrument id, `<market>:<symbol>`.",
              "examples": [
                "crypto:BTCUSDT"
              ],
              "title": "Instrument",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "timeframe",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Timeframe",
              "examples": [
                "1h"
              ]
            }
          },
          {
            "description": "Start of the period, inclusive: UTC epoch seconds or ISO 8601 (`2024-06-03`, `2024-06-03T13:30:00Z`; without an offset it is UTC).",
            "in": "query",
            "name": "start",
            "required": true,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "format": "date-time",
                  "type": "string"
                }
              ],
              "examples": [
                "2024-06-03",
                "2024-06-03T13:30:00Z",
                1717421400
              ],
              "title": "Start"
            }
          },
          {
            "description": "End of the period, exclusive, in the same formats; default now.",
            "in": "query",
            "name": "end",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "minimum": 0,
                      "type": "integer"
                    },
                    {
                      "format": "date-time",
                      "type": "string"
                    }
                  ],
                  "examples": [
                    "2024-06-03",
                    "2024-06-03T13:30:00Z",
                    1717421400
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "End of the period, exclusive, in the same formats; default now.",
              "examples": [
                "2024-06-04"
              ],
              "title": "End"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandlesOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The instrument is not in the catalog (`instrument-not-found`)."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid parameters (`validation`), a period outside the available data (`period-out-of-range`) or more candles than `max_candles` (`too-many-candles`)."
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "More candle and instrument requests from this address than the per-minute limit (`rate-limited`); see `Retry-After`."
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The source sent data that failed validation (`source-data-invalid`)."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The source is down or our request budget for it is spent (`source-unavailable`); `Retry-After` when waiting helps."
          }
        },
        "summary": "Candles",
        "tags": [
          "data"
        ]
      }
    },
    "/api/v1/data/instruments": {
      "get": {
        "description": "Searches the instruments of both markets: every Binance spot pair that is trading and\nevery active tradable US stock and ETF at Alpaca (without OTC).\n\nRanking: the top pair of a crypto base asset equal to the query (`btc` finds `BTCUSDT`\nfirst), exact symbol, the other pairs of that base asset, symbol prefix, prefix of a word\nin the name, substring of the symbol, substring of the name; ties go to the shorter symbol,\nthen alphabetically.\n\nWhen the instrument list of one market cannot be loaded, the other market is still\nsearched and `unavailable` names the missing one; 503 when no market can be searched.",
        "operationId": "search_instruments_api_v1_data_instruments_get",
        "parameters": [
          {
            "description": "Symbol or name, case-insensitive; separators in symbols are ignored (`btc/usdt` finds `BTCUSDT`, `brkb` finds `BRK.B`).",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "Symbol or name, case-insensitive; separators in symbols are ignored (`btc/usdt` finds `BTCUSDT`, `brkb` finds `BRK.B`).",
