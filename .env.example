# Settings of the backend (backend/src/candlestack/core/config.py). Copy to .env for
# compose.yaml; every variable is optional and an empty value means the default.
# Never commit .env.

# local, test, stage, prod or pr-<N>
APP_ENV=local
# Deployed version (main-<sha>, v0.2.0, pr-<N>-<sha>); set by the deploy
APP_VERSION=dev
# Commit the image was built from; baked in at build time
APP_COMMIT=
# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# Cache; compose.yaml points the backend at its own Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Alpaca paper account (https://app.alpaca.markets/paper/dashboard/overview); US stocks
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Assets, calendar and clock
ALPACA_API_URL=https://paper-api.alpaca.markets
# Bars
ALPACA_DATA_URL=https://data.alpaca.markets

# Binance REST and public archives; crypto, no keys needed
BINANCE_API_URL=https://api.binance.com
BINANCE_DATA_URL=https://data.binance.vision

# logo.dev publishable key (https://www.logo.dev/dashboard); instrument icons. Empty: every icon
# is the fallback image
LOGO_DEV_KEY=
LOGO_DEV_URL=https://img.logo.dev

# Most candles in one candle response
CANDLES_MAX=50000
# Candle and instrument-detail requests per minute per client IP (IPv6: per /64); 0 disables
CLIENT_RATE_LIMIT=60
# Our Alpaca requests per minute; default by APP_ENV: prod 150, stage 60, pr-<N> 30, else 60
ALPACA_RATE_LIMIT=
# Our Binance REST weight per minute
BINANCE_WEIGHT_LIMIT=1000
# Our logo.dev requests per minute (their free plan allows 100 for all environments together);
# default by APP_ENV: prod 50, stage 20, pr-<N> 5, else 20
LOGO_DEV_RATE_LIMIT=

# Sentry project that gets the errors, traces, profiles and logs; empty sends nothing (the deploy
# sets it for prod and stage only)
SENTRY_DSN=
# Share of requests traced in Sentry, 0 to 1; default by APP_ENV: prod 0.2, else 1.0
SENTRY_TRACES_SAMPLE_RATE=

# Frontend dev server (frontend/vite.config.ts), not the backend: where `npm run dev` forwards
# /api/*. Empty is the prod API; http://localhost:8000 is the backend from `docker compose up`.
API_TARGET=
