#!/usr/bin/env bash
# Forced command for the deploy user's SSH keys (see deploy_authorized_keys).
# Every key has a scope and can only run these commands for its own environments:
#
#   scope    command
#   prod     up prod <version> <backend@digest> <frontend@digest>
#   stage    up stage <version> <backend@digest> <frontend@digest>   |   edge   |   agent <image@digest>
#   preview  up pr-<N> <version> <backend@digest> <frontend@digest>  |   down pr-<N>
#
# "up" and "agent" read a GHCR token from the first line of stdin and use it only for this
# one pull. "up" then reads the backend's secrets as KEY=VALUE lines (only ALPACA_KEY_ID and
# ALPACA_SECRET_KEY) and passes them to compose in its environment: no file, never printed.
# "up prod" runs compose with infra/env/compose.yaml of the release tag named by <version>
# instead of this checkout's copy (see release_compose_file); every other "up" uses this
# checkout's file, same as before.
# "edge" updates the checkout to origin/main and reloads the edge Caddy.
# "agent" (re)starts the server agent from infra/agent/compose.yaml of that checkout.
set -euo pipefail
export LC_ALL=C # byte-wise character ranges in the input checks below

scope=${1:?scope}
read -r action env version backend frontend _ <<<"${SSH_ORIGINAL_COMMAND:-}"
repo=/opt/candlestack
image_re='^ghcr\.io/candlestack-fei-stu/candlestack/[a-z0-9._-]+@sha256:[0-9a-f]{64}$'
compose_file=$repo/infra/env/compose.yaml

# Temporary directories to remove on exit (DOCKER_CONFIG of pull(), the tag's compose file
# of release_compose_file()).
cleanup_paths=()
cleanup() {
  rm -rf "${cleanup_paths[@]}"
}
trap cleanup EXIT

fail() {
  echo "candlestack-deploy: $*" >&2
  exit 1
}

may_touch() {
  case "$scope" in
    prod) [ "$1" = prod ] ;;
    stage) [ "$1" = stage ] ;;
    preview) [[ $1 =~ ^pr-[0-9]{1,6}$ ]] ;;
    *) return 1 ;;
  esac
}

# Redis is a cache: maxmemory, and the container limit a little above it.
redis_memory() {
  case "$1" in
    prod) REDIS_MAXMEMORY=256mb REDIS_MEM_LIMIT=288m ;;
    stage) REDIS_MAXMEMORY=128mb REDIS_MEM_LIMIT=160m ;;
    *) REDIS_MAXMEMORY=64mb REDIS_MEM_LIMIT=96m ;;
  esac
  export REDIS_MAXMEMORY REDIS_MEM_LIMIT
}

compose() {
  docker compose -p "$env" -f "$compose_file" "$@"
}

# Every backend build brings a new source layer of about 150 KB, and a dependency layer of
# about 250 MB when uv.lock changes. Images no container uses any more (earlier versions,
# removed previews) go, so the disk does not fill up; a deploy pulls what it needs again anyway.
prune_images() {
  docker image prune --all --force >/dev/null
}

# prod must start with the deploy files of the tagged release, not whatever main's checkout
# has today (edge resets it to origin/main on every stage deploy). Validates that <version> is
# a release tag reachable from main, fetches it into this checkout (never the working tree,
# so the running script is untouched) and points compose_file at that tag's infra/env/compose.yaml.
release_compose_file() {
  local tag=$1 commit dir
  [[ $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$ ]] ||
    fail "prod version must be a release tag (vX.Y.Z): '$tag'"
  git -C "$repo" fetch --quiet --no-tags origin tag "$tag" ||
    fail "release tag '$tag' not found on origin"
  commit=$(git -C "$repo" rev-parse --verify --quiet "refs/tags/$tag^{commit}") ||
    fail "release tag '$tag' does not point to a commit"
  # The checkout is a shallow clone (see cloud-init.yaml): deepen it so main's real history,
  # not just its latest commit, is available to check the tag against.
  if [ "$(git -C "$repo" rev-parse --is-shallow-repository)" = true ]; then
    git -C "$repo" fetch --quiet --unshallow origin main
  else
    git -C "$repo" fetch --quiet origin main
  fi
  git -C "$repo" merge-base --is-ancestor "$commit" origin/main ||
    fail "release tag '$tag' is not on main's history"
  dir=$(mktemp -d)
  cleanup_paths+=("$dir")
  git -C "$repo" show "$commit:infra/env/compose.yaml" >"$dir/compose.yaml" ||
    fail "release tag '$tag' has no infra/env/compose.yaml"
  compose_file=$dir/compose.yaml
}

check_image() {
  [[ $1 =~ $image_re ]] || fail "image must be a GHCR digest reference: '$1'"
}

read_token() {
  read -r token || fail "expected a GHCR token on stdin"
}

# The lines after the token, until EOF. Nothing read here is ever printed.
read_secrets() {
  local line key value
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || continue
    [[ $line == *=* ]] || fail "expected KEY=VALUE lines after the token on stdin"
    key=${line%%=*}
    value=${line#*=}
    [[ $key =~ ^(ALPACA_KEY_ID|ALPACA_SECRET_KEY)$ ]] ||
      fail "only ALPACA_KEY_ID and ALPACA_SECRET_KEY may follow the token on stdin"
    [[ $value =~ ^[!-~]{0,256}$ && $value != *[\"\'\`\\]* ]] ||
      fail "$key must be at most 256 printable characters without spaces or quotes"
    export "$key=$value"
  done
}

# Logs in to GHCR with the token for this command only and pulls the images.
pull() {
  local image
  DOCKER_CONFIG=$(mktemp -d)
  export DOCKER_CONFIG
  cleanup_paths+=("$DOCKER_CONFIG")
  docker login ghcr.io --username deploy --password-stdin <<<"$token" >/dev/null
  for image in "$@"; do
    docker pull --quiet "$image"
  done
}

case "${action:-}" in
  up)
    may_touch "$env" || fail "the $scope key may not deploy '$env'"
    [[ $version =~ ^[A-Za-z0-9._-]{1,64}$ ]] || fail "bad version: '$version'"
    check_image "$backend"
    check_image "$frontend"
    if [ "$env" = prod ]; then
      release_compose_file "$version"
    fi
    read_token
    read_secrets
    pull "$backend" "$frontend"
    redis_memory "$env"
    ENV_NAME=$env APP_VERSION=$version BACKEND_IMAGE=$backend FRONTEND_IMAGE=$frontend \
      compose up --detach --remove-orphans
    prune_images
    ;;
  down)
    [ "$scope" = preview ] || fail "only the preview key removes environments"
    may_touch "$env" || fail "the $scope key may not remove '$env'"
    # compose needs every variable of the file, even to remove the containers.
    redis_memory "$env"
    ENV_NAME=$env APP_VERSION=none BACKEND_IMAGE=none FRONTEND_IMAGE=none \
      compose down --remove-orphans
    prune_images
    ;;
  edge)
    [ "$scope" = stage ] || fail "only the stage key updates the edge"
    git -C "$repo" fetch --quiet --depth 1 origin main
    git -C "$repo" reset --quiet --hard FETCH_HEAD
    docker compose -f "$repo/infra/edge/compose.yaml" up --detach
    docker compose -f "$repo/infra/edge/compose.yaml" exec -T caddy caddy reload --config /etc/caddy/Caddyfile
    ;;
  agent)
    [ "$scope" = stage ] || fail "only the stage key deploys the server agent"
    image=$env # "agent <image@digest>": the image is the first argument
    check_image "$image"
    read_token
    pull "$image"
    IMAGE=$image docker compose -p agent -f "$repo/infra/agent/compose.yaml" up --detach --remove-orphans
    ;;
  *)
    fail "unknown command: '${SSH_ORIGINAL_COMMAND:-}'"
    ;;
esac
