{
	auto_https off
}

# Responses of the environments are compressed on the way to Cloudflare, which gives each
# client an encoding it accepts: a year of 1h candles is about 500 KB of JSON. Bodies under
# 512 bytes (/api/health) are left as they are. Streamed responses still stream: the encoder is
# flushed whenever the proxied response is.
(compress) {
	encode zstd gzip
}

# One environment: /api/* to its backend, everything else to its frontend.
# Usage: import env <env name>
(env) {
	import compress
	handle /api/* {
		reverse_proxy {args[0]}-backend:8000
	}
	handle {
		reverse_proxy {args[0]}-frontend:8080
	}
}

# Transition to the backend + frontend layout: prod keeps running the old single prod-app
# container until the first release with the new layout, and this file is deployed from main
# before that. prod-app is a fallback that gets the requests only while the new upstream does
# not answer. Remove the fallback (use "import env prod") after that first release.
(prod-app-fallback) {
	lb_policy first
	lb_try_duration 3s
	# prod-backend does not exist yet: whenever its failure mark (fail_duration) has expired,
	# a request tries it first. Moving on to prod-app at once keeps that request fast; the
	# default 250 ms wait between tries would be added to it.
	lb_try_interval 10ms
	fail_duration 10s
}

:80 {
	header X-Robots-Tag "noindex, nofollow"

	@prod host app.candlestack.tech
	handle @prod {
		import compress
		handle /api/* {
			reverse_proxy prod-backend:8000 prod-app:8080 {
				import prod-app-fallback
			}
		}
		handle {
			reverse_proxy prod-frontend:8080 prod-app:8080 {
				import prod-app-fallback
			}
		}
	}

	@stage host stage.candlestack.tech
	handle @stage {
		import env stage
	}

	# The server agent; ops.candlestack.tech itself is a Cloudflare Worker.
	@vm host vm.candlestack.tech
	handle @vm {
		reverse_proxy vm-agent:8080
	}

	# pr-<N>-preview.candlestack.tech -> the pr-<N> environment
	@preview vars_regexp preview {host} ^(pr-[0-9]+)-preview\.candlestack\.tech$
	handle @preview {
		import env {re.preview.1}
	}

	handle {
		respond "Not found" 404
	}

	handle_errors 502 {
		respond "Nothing is deployed at {host}" 502
	}
}
