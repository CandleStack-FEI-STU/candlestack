{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	header -Server

	handle /api/health {
		header Content-Type application/json
		respond `{"status":"ok","env":"{env.APP_ENV}","version":"{env.APP_VERSION}","commit":"{env.APP_COMMIT}"}` 200
	}

	handle {
		root * /srv
		templates
		file_server
	}
}
