# Normalize line endings: LF in the repository and in working trees on every OS
* text=auto eol=lf

# Windows-only scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: no line ending conversion, no textual diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.keras binary
*.h5 binary
*.pkl binary
*.npy binary
*.npz binary
*.parquet binary
*.woff binary
*.woff2 binary
